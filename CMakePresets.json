{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug-config",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-config",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local"
      }
    },
    {
      "name": "metal-backend",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    { "name": "debug-metal", "inherits": ["debug-config", "metal-backend"] },
    {
      "name": "release-metal",
      "inherits": ["release-config", "metal-backend"]
    }
  ],
  "buildPresets": [
    {
      "name": "debug-metal",
      "configurePreset": "debug-metal"
    },
    {
      "name": "release-metal",
      "configurePreset": "release-metal"
    }
  ]
}
